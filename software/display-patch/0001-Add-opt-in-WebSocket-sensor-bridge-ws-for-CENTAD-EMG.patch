+/* ==========================================================================
+   9b. SENSOR BRIDGE (opt-in WebSocket)
+   ========================================================================== */
+/*
+   Off unless the URL has ?ws=<url>. Without it nothing below runs and the
+   display behaves exactly as before.
+
+     ?ws=ws://centad-emg.local:81   connect to the CENTAD EMG node (Pico 2 W)
+     ?ws=auto                       ws://<this page's host>:81, for when the
+                                    page itself is served by the Pico
+
+   Every message carrying a numeric `act` (0..1) is passed to setDrive().
+   Anything else (calibration events etc.) is ignored. If no data arrives for
+   STALE_MS, drive ramps to 0 so the dog never keeps running on a dead link.
+   Reconnects automatically with back-off.
+
+   Browsers refuse ws:// from an https:// page (mixed content), so on the
+   Vercel deployment this reports "blocked" instead of connecting; open the
+   copy served by the Pico (http://centad-emg.local/) instead.
+*/
+
+const Bridge = (() => {
+  const param = new URLSearchParams(location.search).get("ws");
+  const STALE_MS = 1000;           // no data for this long -> ramp to 0
+  const RAMP_DOWN_SECONDS = 0.5;   // full-scale ramp to zero when stale
+  const RETRY_MIN_MS = 500;
+  const RETRY_MAX_MS = 5000;
+
+  const state = {
+    enabled: !!param,
+    url: "",
+    status: "off",        // off | connecting | open | stale | closed | blocked
+    lastMsgAt: 0,
+    lastAct: 0,
+    sensor: "",           // Pico-side status: ok | calibrating | sensor_fault | uncalibrated
+    rateHz: 0,
+    note: "",
+  };
+  if (!state.enabled) return { state, update() {} };
+
+  state.url = param === "auto"
+    ? "ws://" + location.hostname + ":81"
+    : param;
+
+  let ws = null;
+  let retryMs = RETRY_MIN_MS;
+  let retryTimer = 0;
+  let msgCount = 0;
+  let rateWindowStart = performance.now();
+
+  function scheduleReconnect() {
+    clearTimeout(retryTimer);
+    retryTimer = setTimeout(connect, retryMs);
+    retryMs = Math.min(retryMs * 2, RETRY_MAX_MS);
+  }
+
+  function connect() {
+    clearTimeout(retryTimer);
+    if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) return;
+    state.status = "connecting";
+    try {
+      ws = new WebSocket(state.url);
+    } catch (err) {
+      // SecurityError: ws:// from an https:// page. Retrying will not help.
+      state.status = "blocked";
+      state.note = location.protocol === "https:"
+        ? "https page cannot open ws://; use http://centad-emg.local/"
+        : String(err && err.message || err);
+      return;
+    }
+    ws.onopen = () => {
+      state.status = "open";
+      state.note = "";
+      retryMs = RETRY_MIN_MS;
+    };
+    ws.onmessage = (ev) => {
+      let m;
+      try { m = JSON.parse(ev.data); } catch (_) { return; }
+      if (typeof m.status === "string") state.sensor = m.status;
+      if (typeof m.act !== "number") return;
+      state.lastMsgAt = performance.now();
+      state.lastAct = m.act;
+      msgCount++;
+      if (state.status === "stale") state.status = "open";
+      window.setDrive(m.act);
+    };
+    ws.onclose = () => {
+      ws = null;
+      if (state.status !== "blocked") state.status = "closed";
+      scheduleReconnect();
+    };
+    ws.onerror = () => { /* onclose follows and handles retry */ };
+  }
+
+  // iPad Safari kills sockets when the tab sleeps; reconnect straight away on return.
+  document.addEventListener("visibilitychange", () => {
+    if (document.visibilityState === "visible" && !ws && state.status !== "blocked") {
+      retryMs = RETRY_MIN_MS;
+      connect();
+    }
+  });
+
+  connect();
+
+  /** Called once per frame from the main loop. */
+  function update(dt) {
+    const now = performance.now();
+    if (now - rateWindowStart >= 1000) {
+      state.rateHz = msgCount * 1000 / (now - rateWindowStart);
+      msgCount = 0;
+      rateWindowStart = now;
+    }
+    const silent = state.lastMsgAt === 0 || now - state.lastMsgAt > STALE_MS;
+    if (!silent) return;
+    if (state.status === "open") state.status = "stale";
+    // Fail safe: no fresh data -> walk drive down to 0 (the display's own
+    // smoothing filter then eases the dog to a stop).
+    const d = window.getDrive();
+    if (d > 0) window.setDrive(Math.max(0, d - dt / RAMP_DOWN_SECONDS));
+  }
+
+  return { state, update };
+})();
+
 // FPS readout, refreshed a few times a second so the HUD does not thrash layout.
 let fpsAvg = 60;
 let hudCountdown = 0;
@@ -910,7 +1034,16 @@ function updateHud(dt) {
     "drive (out) " + driveSmooth.toFixed(3) + "\n" +
     "contingency " + (contingency ? "ON" : "OFF") + "\n" +
     "audio       " + (Sound.isMuted() ? "MUTED" : "on") + "\n" +
-    "fps         " + fpsAvg.toFixed(0);
+    "fps         " + fpsAvg.toFixed(0) +
+    (Bridge.state.enabled
+      ? "\n" +
+        "ws          " + Bridge.state.status +
+          (Bridge.state.status === "open" ? " " + Bridge.state.rateHz.toFixed(0) + " Hz" : "") + "\n" +
+        "ws url      " + Bridge.state.url + "\n" +
+        "emg act     " + Bridge.state.lastAct.toFixed(3) +
+          (Bridge.state.sensor ? "  (" + Bridge.state.sensor + ")" : "") +
+        (Bridge.state.note ? "\n" + Bridge.state.note : "")
+      : "");
 }
 
 
@@ -928,6 +1061,7 @@ function frame(now) {
   if (dt > 0.05) dt = 0.05;
 
   updateDebugInput(dt);
+  Bridge.update(dt);
   updateDrive(dt);
 
   const d = driveSmooth;
